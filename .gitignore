.env.*
*.env
*.pem
*.key

# журналы и профили
*.log
prof.out

# модуль заказчика (ТЗ 4.5): чужой код, кладётся в рабочую копию и на сервер отдельно
cormap/refinery.py

# настоящие книги заказчика
starter/*.xlsx

# рабочая копия стартового набора: в git остаётся только исходник калькулятора
starter/*
!starter/Калькулятор ЭХЗ.html
